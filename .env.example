PROJECT_NAME=Faserkraft Website API
# development | production
ENVIRONMENT=development

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=fk_web

# минимум 32 символа; сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
# в production пустое значение остановит запуск
SECRET_KEY=
ADMIN_SESSION_MAX_AGE_SECONDS=28800

CORS_ORIGINS=["http://localhost:3000"]

# true только за своим прокси, который выставляет X-Forwarded-For
TRUST_PROXY=false

FRONTEND_REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate/homepage
FRONTEND_REVALIDATE_SECRET=
